#!/usr/bin/env bash
echo 'Starting bluetooth connect script'
bluetoothctl connect 00:17:E9:DB:0A:CC
sink=$(pactl list short sinks | awk '/bluez/ {print $2; exit}')
if [ -n "$sink" ]; then
	pactl set-default-sink "$sink"
	pactl list short sink-inputs | while read -r id _; do
		pactl move-sink-input "$id" "$sink"
	done
fi
